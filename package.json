{
  "name": "tel-aviv-time-machine",
  "version": "0.1.0",
  "private": true,
  "description": "A web-based 3D time machine of Tel Aviv: scroll through the years and watch the same streets change.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node tools/assets/pack.mjs",
    "assets:build": "node tools/assets/pack.mjs build",
    "assets:publish": "node tools/assets/pack.mjs publish"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@types/three": "0.169.0",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
